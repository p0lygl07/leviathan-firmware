#!/bin/sh
# ---------------------------------------------------------------
# LEVIATHAN first-boot defaults (runs once, after FriendlyWrt's
# vendor.defaults / setup.sh because uci-defaults run in name order)
# ---------------------------------------------------------------

LAN_IP="192.168.42.1"
AP_KEY="leviathan"
ROOT_PW="leviathan"

# --- identity ---------------------------------------------------
uci -q batch <<-EOF
	set system.@system[0].hostname='leviathan'
	set system.@system[0].timezone='EST5EDT,M3.2.0,M11.1.0'
	set system.@system[0].zonename='America/New_York'
	commit system
EOF

# --- LAN --------------------------------------------------------
# 192.168.42.0/24 instead of FriendlyWrt's 192.168.2.0/24 so it
# is less likely to collide with whatever network we uplink into.
uci set network.lan.ipaddr="$LAN_IP"
uci commit network

# --- onboard Wi-Fi 6 (AIC8800) -> LEVIATHAN access point ---------
# /etc/config/wireless is generated by `wifi config` before
# uci-defaults run, so radio0 / default_radio0 already exist.
if uci -q get wireless.radio0 >/dev/null; then
	MAC=$(cat /sys/class/net/eth0/address 2>/dev/null)
	SUFFIX=$(echo "$MAC" | awk -F: '{print toupper($5 $6)}')
	[ -n "$SUFFIX" ] || SUFFIX="0000"

	uci -q batch <<-EOF
		set wireless.radio0.country='US'
		set wireless.radio0.disabled='0'
		set wireless.default_radio0.disabled='0'
		set wireless.default_radio0.mode='ap'
		set wireless.default_radio0.network='lan'
		set wireless.default_radio0.ssid='LEVIATHAN-${SUFFIX}'
		set wireless.default_radio0.encryption='psk2'
		set wireless.default_radio0.key='${AP_KEY}'
		commit wireless
	EOF
fi

# --- root password ----------------------------------------------
printf '%s\n%s\n' "$ROOT_PW" "$ROOT_PW" | passwd root >/dev/null 2>&1

# --- branding ---------------------------------------------------
uci -q batch <<-EOF
	set luci.main.mediaurlbase='/luci-static/argon'
	commit luci
EOF

logger -t leviathan "first-boot defaults applied (LAN ${LAN_IP})"
exit 0
